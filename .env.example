# This file contains examples only. Never put a real Secret or Token in Git.

# Select one complete business backend. `auto` prefers an existing API configuration.
# FREEE_BACKEND=playwright
# FREEE_BROWSER_HEADLESS=true
# FREEE_BROWSER_CHANNEL=chrome
# FREEE_BROWSER_PROFILE_DIR=/absolute/path/outside/the/repository
# FREEE_BROWSER_DIAGNOSTIC_DIR=/private/temporary/path/outside/the/repository
# FREEE_WEB_CREDENTIAL_SERVICE=freee-agent-web

# Non-secret overrides. `auth configure` normally writes these to .freee/oauth.json.
# FREEE_SECRET_STORE=system
# FREEE_CLIENT_ID=your-client-id
# FREEE_OAUTH_REDIRECT_URI=http://127.0.0.1:48181/callback
# FREEE_SYSTEM_KEYRING_SERVICE=freee-agent

# Environment mode values must be injected by a Secret Manager or CI.
# Do not save real values here.
# FREEE_SECRET_STORE=environment
# FREEE_ACCESS_TOKEN=provided-at-runtime

# Optional overrides for development and testing.
# FREEE_API_BASE_URL=https://api.freee.co.jp/hr/api/v1
# FREEE_OAUTH_TOKEN_URL=https://accounts.secure.freee.co.jp/public_api/token
