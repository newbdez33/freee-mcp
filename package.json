{
  "name": "freee-agent-cli",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "description": "A safety-first freee attendance MCP server and CLI for coding agents",
  "keywords": [
    "freee",
    "mcp",
    "agent-skill",
    "pi-package"
  ],
  "type": "module",
  "bin": {
    "freee-agent": "scripts/standalone-cli.mjs",
    "freee-mcp": "scripts/standalone-mcp.mjs"
  },
  "files": [
    "dist/",
    "scripts/plugin-cli.mjs",
    "scripts/plugin-runtime.mjs",
    "scripts/standalone-cli.mjs",
    "scripts/standalone-mcp.mjs",
    "skills/freee/"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "check": "npm run build && node --test",
    "validate": "node scripts/validate-distribution.mjs",
    "package:smoke": "node scripts/smoke-package.mjs",
    "freee": "npm run build --silent && node dist/cli.js",
    "mcp": "npm run build --silent && node dist/mcp-entry.js",
    "test": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  }
}
